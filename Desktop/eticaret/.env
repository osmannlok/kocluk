# .env.example
# Kopyala: cp .env.example .env  (.env asla git'e eklenmez, web'den erişilemez)

# --- Uygulama ---
# Site adı (e-postalarda ve başlıkta kullanılır)
APP_NAME="Yöresel Market"
# Ortam: local | production (production'da HSTS ve katı ayarlar açılır)
APP_ENV=local
# Hata ayrıntısı: üretimde MUTLAKA false (ayrıntı sızıntısını önler)
APP_DEBUG=true
# Sitenin tam adresi (sonunda / olmadan)
APP_URL=http://eticaret.local
# 64 haneli hex anahtar (çerez imzası vb.). Üret: php -r 'echo bin2hex(random_bytes(32));'
APP_KEY=
# Güvenilir proxy IP'leri, virgülle ayır (boşsa X-Forwarded-For yok sayılır)
TRUSTED_PROXIES=

# --- Veritabanı ---
# Veritabanı sunucusu
DB_HOST=127.0.0.1
# Veritabanı portu
DB_PORT=3306
# Veritabanı adı
DB_NAME=yoresel_market
# Kullanıcı: geliştirmede ym_dev; üretimde kısıtlı yetkili ym_app kullan
DB_USER=ym_dev
# UYARI: Parolayı boş bırakma; güçlü ve benzersiz bir parola ver
DB_PASS=

# --- Oturum ---
# Oturum çerezi adı
SESSION_COOKIE_NAME=ym_session
# Boşta kalma zaman aşımı (dakika)
SESSION_IDLE_MINUTES=60
# Mutlak oturum süresi (dakika); dolunca yeniden giriş gerekir
SESSION_ABSOLUTE_MINUTES=720

# --- E-posta ---
# Sürücü: log (storage/mail'e yazar) | smtp
MAIL_DRIVER=log
# SMTP sunucusu
MAIL_HOST=
# SMTP portu (587 TLS, 465 SSL)
MAIL_PORT=587
# SMTP kullanıcı adı
MAIL_USER=
# SMTP parolası
MAIL_PASS=
# Şifreleme: tls | ssl (boş = şifresiz, önerilmez)
MAIL_ENCRYPTION=tls
# Gönderen e-posta adresi
MAIL_FROM_ADDRESS=

# --- Yükleme ---
# Görsel yükleme üst sınırı (MB)
UPLOAD_MAX_MB=5

# --- PayTR (gizli anahtarlar yalnızca burada tutulur) ---
# Mağaza numarası
PAYTR_MERCHANT_ID=
# Mağaza parolası (gizli)
PAYTR_MERCHANT_KEY=
# Mağaza gizli anahtarı (gizli)
PAYTR_MERCHANT_SALT=
# Test modu: 1 = test, 0 = canlı
PAYTR_TEST_MODE=1
# Hata mesajı gösterimi: 1 = açık (üretimde 0)
PAYTR_DEBUG_ON=1
# Ödeme sayfası zaman aşımı (dakika)
PAYTR_TIMEOUT_LIMIT=30
# Azami taksit sayısı (0 = tüm taksitler)
PAYTR_MAX_INSTALLMENT=0