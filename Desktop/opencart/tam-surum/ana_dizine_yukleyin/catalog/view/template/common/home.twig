{{ header }}
<div id="common-home" class="page-home">
  <section class="home-hero container-fluid px-0">
    <div class="container home-hero-inner">
      <div class="home-hero-copy" data-modern-reveal>
        <p class="eyebrow">Modern Storefront</p>
        <h1 class="home-hero-title">Discover products with a smoother, sharper shopping experience.</h1>
        <p class="home-hero-sub">Curated collections, fluid motion, and a clean interface powered by a refreshed OpenCart theme.</p>
      </div>
    </div>
  </section>
  <div class="container home-content-wrap">
    <div class="row">{{ column_left }}
      <div id="content" class="col">{{ content_top }}{{ content_bottom }}</div>
      {{ column_right }}</div>
  </div>
</div>
{{ footer }}