APP_NAME="Egitim Oyun Portali"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oyun_portali
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=oyun_portali_session
SESSION_LIFETIME=120
SESSION_SECURE=false

CACHE_DRIVER=file
CACHE_TTL=3600

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"